// Regression Slope Oscillator Strategy
// Based on "Regression Slope Oscillator [BigBeluga]" indicator
// Strategy logic translated from Python backtest (supertrend.py)
//
// Signal rules (matching Python backtest exactly):
//   LONG  : crossover(slopeOscillator, sigL) AND slopeOscillator < 0 AND ATR filter
//   SHORT : crossunder(slopeOscillator, sigL) AND slopeOscillator > 0 AND ATR filter
//   ATR filter: ATR(atrLength) > SMA(ATR(atrLength), atrLength)

//@version=6
strategy(
  "Regression Slope Oscillator Strategy",
  overlay            = false,
  default_qty_type   = strategy.percent_of_equity,
  default_qty_value  = 100,
  commission_type    = strategy.commission.percent,
  commission_value   = 0.05,
  initial_capital    = 10000
)


// ── INPUTS ────────────────────────────────────────────────────────────────────
maxRange  = input.int(100, "Max Range",                minval = 2)
minRange  = input.int(10,  "Min Range",                minval = 2)
stepSize  = input.int(5,   "Step",                     minval = 1)
sigLine   = input.int(7,   "Signal Line",              minval = 1)
atrLength = input.int(10,  "ATR Length (Vol. Filter)", minval = 1)


// ── REGRESSION SLOPE OSCILLATOR ───────────────────────────────────────────────
f_log_regression(src, length) =>
    float sumX    = 0.0
    float sumY    = 0.0
    float sumXSqr = 0.0
    float sumXY   = 0.0
    for i = 0 to length - 1
        val  = math.log(src[i])
        per  = float(i + 1)
        sumX    += per
        sumY    += val
        sumXSqr += per * per
        sumXY   += val * per
    denom = length * sumXSqr - sumX * sumX
    slope = denom != 0 ? (length * sumXY - sumX * sumY) / denom : 0.0
    slope * -1.0

slopAvg = array.new<float>()
for i = minRange to maxRange by stepSize
    array.push(slopAvg, f_log_regression(close, i))

slopeOscillator = array.avg(slopAvg)
sigL            = ta.sma(slopeOscillator, sigLine)


// ── ATR VOLATILITY FILTER ─────────────────────────────────────────────────────
atrVal    = ta.atr(atrLength)
atrSma    = ta.sma(atrVal, atrLength)
atrFilter = atrVal > atrSma


// ── ENTRY CONDITIONS ──────────────────────────────────────────────────────────
longCond  = ta.crossover(slopeOscillator, sigL)  and slopeOscillator < 0 and barstate.isconfirmed and atrFilter
shortCond = ta.crossunder(slopeOscillator, sigL) and slopeOscillator > 0 and barstate.isconfirmed and atrFilter

if longCond
    strategy.entry("Long",  strategy.long)

if shortCond
    strategy.entry("Short", strategy.short)


// ── PLOTS ─────────────────────────────────────────────────────────────────────
trendColor = slopeOscillator >= 0 ? color.aqua : color.orange

pslope = plot(slopeOscillator, "Oscillator",   color = color.new(trendColor, 0), linewidth = 2)
p0     = plot(0,               "Zero Line",    color = chart.fg_color)
plot(sigL,                     "Signal Line",  color = chart.fg_color, linewidth = 1)
hline(0)
fill(pslope, p0, slopeOscillator, 0, color.new(trendColor, 60), color(na))

plotshape(longCond  ? slopeOscillator : na, "Long Signal",  shape.triangleup,   location.absolute, color.lime,  size = size.small)
plotshape(shortCond ? slopeOscillator : na, "Short Signal", shape.triangledown, location.absolute, color.red,   size = size.small)
